{
  "name": "a4",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@bufbuild/protobuf": "2.17.0",
    "@huggingface/transformers": "4.3.2",
    "@vinext/cloudflare": "^1.4.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@cloudflare/vite-plugin": "2.0.0-rc.3",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "1.0.0-rc.5",
    "dependency-cruiser": "18.9.0",
    "knip": "6.48.0",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:element": "vite build -c vite.element.config.ts",
    "build:examples": "node scripts/build-example-plugins.ts",
    "start": "vite preview",
    "test": "node --test 'lib/**/*.test.ts' 'components/**/*.test.ts' 'cli/**/*.test.ts' 'examples/**/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "lint": "pnpm lint:code && pnpm lint:deps && pnpm lint:unused && pnpm lint:css && pnpm lint:casts && pnpm lint:element-types",
    "lint:code": "biome check --error-on-warnings .",
    "lint:deps": "depcruise app cli components examples lib scripts types",
    "lint:unused": "knip --no-progress",
    "lint:css": "stylelint \"app/**/*.css\" \"components/**/*.css\"",
    "lint:element-types": "node scripts/gen-element-types.ts --check",
    "lint:casts": "node scripts/cast-report.ts",
    "format": "biome format --write .",
    "gen:element-types": "node scripts/gen-element-types.ts",
    "proto": "buf lint && buf generate --clean",
    "proto:check": "buf lint && node scripts/check-proto.ts && node scripts/check-proto-breaking.ts",
    "check": "pnpm lint && pnpm test && pnpm typecheck && pnpm proto:check && pnpm build && pnpm check:bundle && pnpm build:element",
    "check:bundle": "node scripts/check-bundle.ts",
    "deploy": "vinext-cloudflare deploy",
    "a4": "node cli/a4.ts"
  },
  "engines": {
    "node": ">=24"
  }
}
