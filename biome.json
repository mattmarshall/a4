{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.json",
      "!lib/gen",
      "!.claude",
      "!.agents",
      "!openspec"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useSemanticElements": "warn"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useImportType": "error",
        "noNestedTernary": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["lib/**", "!lib/platform/**", "!lib/render/**", "!lib/models/**", "!**/*.test.ts", "!**/testing/**"],
      "plugins": ["./biome/platform-globals.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Reach browser APIs through the lib/platform ports.",
                  "sessionStorage": "Reach browser APIs through the lib/platform ports.",
                  "indexedDB": "Reach browser APIs through the lib/platform ports.",
                  "navigator": "Reach browser APIs through the lib/platform ports.",
                  "crypto": "Reach browser APIs through the lib/platform ports.",
                  "BroadcastChannel": "Reach browser APIs through the lib/platform ports."
                }
              }
            }
          }
        }
      }
    }
  ]
}
