{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": [
    "app/**/{page,layout,not-found}.tsx",
    "lib/**/*.test.ts",
    "components/**/*.test.ts",
    "lib/models/plugins/semantic/worker.ts",
    "scripts/*.ts",
    // The a4 command (pnpm a4).
    "cli/*.ts",
    "cloudflare.config.ts"
  ],
  "project": ["app/**/*.{ts,tsx,css}", "components/**/*.{ts,tsx,css}", "lib/**/*.ts", "cli/**/*.ts", "scripts/**/*.ts", "types/**/*.ts"],
  "ignore": [
    // The fixture pairs the semantic thresholds were calibrated on (see the
    // archived changes' calibration.md). Calibration runs by hand in the
    // browser, so nothing imports it; the next recalibration reuses it.
    "lib/models/plugins/semantic/calibration-pairs.ts"
  ],
  "ignoreDependencies": [
    // vinext provides the next/* modules.
    "next"
  ],
  // Every finding fails: an export nothing imports is either removed or kept
  // module-private.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
